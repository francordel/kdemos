# ==============================================================================
# KDEMOS Environment Configuration Reference
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Note: For local UI development, mock mode requires NO credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Application Mode
# ------------------------------------------------------------------------------
# Storage mode for user availability and calendar data.
# Options:
#   - mock: In-memory mock storage (recommended for local development, zero credentials required)
#   - cloudflare: Connects to Cloudflare Pages Functions backend (production default)
#   - firebase: Direct client-side connection to Firebase Firestore
REACT_APP_DB_MODE=mock

# ------------------------------------------------------------------------------
# 2. Firebase Frontend Configuration (Required only when REACT_APP_DB_MODE=firebase)
# ------------------------------------------------------------------------------
# Obtained from the Firebase Console (Project Settings > General > Your apps > Web app)
REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ------------------------------------------------------------------------------
# 3. Cloudflare Pages Functions / Backend Environment Variables
# ------------------------------------------------------------------------------
# These variables are used by the serverless functions in functions/api/
# Configure these in Cloudflare Pages dashboard (Settings > Functions > Environment Variables)
# or in a local .dev.vars file when running `wrangler pages dev`.

# Firebase REST API credentials for Cloudflare Workers / Functions proxy:
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key_here

# ------------------------------------------------------------------------------
# 4. Authentication & Notifications (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID for participant sign-in and verified email alerts:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Resend API Key for sending calendar notification emails to subscribed voters:
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Sender address for email notifications (defaults to "KDEMOS <avisos@kdemos.com>" if unset):
NOTIFY_FROM="KDEMOS <avisos@kdemos.com>"
